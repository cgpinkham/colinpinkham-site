---
import Base from '../layouts/BaseLayout.astro';
const work=[['AI-powered RFP & Proposal Pipeline','AI · Automation · Digital Health','An end-to-end workflow for opportunity ingestion, AI categorisation, partner matching, bid/no-bid scoring and proposal generation.','/work#rfp'],['Building the commercial Internet','Internet · Networks · Entrepreneurship','The 1993 TICSA / Internet Africa story: a 64 Kbps international link, four customers and the practical work of building an ISP.','/thinking/early-internet'],['MTN / Verizon integration','CIO · M&A · Transformation','Technology leadership through the integration of Verizon’s African operation into MTN.','/work#mtn'],['Technology & Product Strategy','Strategy · Product · Cloud','Consulting across telecom, ISP and FinTech, including cloud migration, product business cases, due diligence and Agile teams.','/work#strategy']];
const thinking=[['Career archive','Building the first commercial ISP in South Africa','A first-person account of the early days of commercial Internet access in South Africa.','/thinking/early-internet'],['Leadership','Shadow IT and informal support','An argument for learning from the technology already being adopted outside formal IT structures.','/thinking/shadow-it']];
---
<Base>
<section class="shell hero"><div><div class="eyebrow">Technology · Digital Health · Africa</div><h1>Technology leadership with a long memory.</h1><p class="lead">I work across digital health, technology strategy, transformation and complex programme delivery — bringing more than three decades of technology experience in Africa.</p><div class="actions"><a class="button" href="/work">Explore my work</a><a class="button secondary" href="/cv">Download CV</a></div></div><aside class="hero-aside"><p>From building South Africa’s early commercial Internet infrastructure to leading technology organisations, M&A integrations and multi-donor digital health programmes.</p></aside></section>
<section class="shell stat-grid"><div class="stat"><strong>30+</strong><span>years in technology</span></div><div class="stat"><strong>7</strong><span>current programme countries</span></div><div class="stat"><strong>$10m+</strong><span>IT budget responsibility</span></div><div class="stat"><strong>2022–2026</strong><span>Jembi Health Systems · full-time</span></div></section>
<section class="shell section"><div class="section-head"><div><div class="eyebrow">Currently</div><h2>Digital health & programme leadership</h2></div><p class="section-intro">Senior Program Manager at Jembi Health Systems (2022–2026), leading multi-donor programmes across sub-Saharan Africa while combining delivery, financial management, resource planning and technology-enabled innovation.</p></div></section>
<section class="shell section"><div class="section-head"><div><div class="eyebrow">Selected work</div><h2>What I’ve built and led</h2></div><a href="/work">View all →</a></div><div class="cards">{work.map(([t,tags,p,href])=><a class="card" href={href}><div class="eyebrow">Selected work</div><h3>{t}</h3><p>{p}</p><div class="tags">{tags.split(' · ').map(x=><span class="tag">{x}</span>)}</div></a>)}</div></section>
<section class="shell section"><div class="section-head"><div><div class="eyebrow">Career</div><h2>1993 → present</h2></div><a href="/career">Explore career →</a></div><div class="timeline"><div class="timeline-item"><div class="year">1993–1996</div><h3>Building the commercial Internet</h3><p class="muted">TICSA → Internet Africa</p></div><div class="timeline-item"><div class="year">1996–2003</div><h3>Scaling UUNET</h3><p class="muted">Product, business development and African operations</p></div><div class="timeline-item"><div class="year">2004–2009</div><h3>Global telecom</h3><p class="muted">WorldCom / Verizon Business</p></div><div class="timeline-item"><div class="year">2009–2014</div><h3>CIO at MTN</h3><p class="muted">IT leadership, integration and transformation</p></div><div class="timeline-item"><div class="year">2014–2018</div><h3>Consulting → VAST Networks</h3><p class="muted">Technology strategy, product and operations</p></div><div class="timeline-item"><div class="year">2018–2022</div><h3>Consulting</h3><p class="muted">Technology & product strategy</p></div><div class="timeline-item"><div class="year">2022–2026</div><h3>Digital health & programme leadership</h3><p class="muted">Jembi Health Systems · full-time</p></div></div></section>
<section class="shell section"><div class="section-head"><div><div class="eyebrow">Thinking</div><h2>Ideas, lessons and observations</h2></div><a href="/thinking">Read the archive →</a></div><div class="cards">{thinking.map(([cat,t,p,href])=><a class="card" href={href}><div class="eyebrow">{cat}</div><h3>{t}</h3><p>{p}</p></a>)}</div></section>
</Base>
